APP_ENV=development
CORS_ORIGINS=http://localhost:8000
REQUIRE_SENSOR_SIGNATURES=false
SENSOR_SECRETS_JSON={"sensor-001":"replace-with-a-long-random-secret"}
SIGNATURE_MAX_AGE_SECONDS=300
SHELBY_STORAGE_REQUIRED=false
SHELBY_BRIDGE_URL=http://shelby-bridge:8787
SHELBY_BRIDGE_TOKEN=replace-with-an-internal-service-token
SHELBY_BLOB_TTL_SECONDS=2592000
SHELBY_API_KEY=aptoslabs_replace_me
SHELBY_ACCOUNT_PRIVATE_KEY=ed25519-priv-0xreplace_me
PORT=8787
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
ENVIRONMENT_CACHE_TTL_SECONDS=600
