module rwa_builder::asset_registry {
    use std::signer;

    struct Asset has key, store {
        owner: address,
        asset_id: vector<u8>,
        livability_score: u64,
        structural_score: u64,
        risk_level: u8,
        last_updated: u64,
    }

    public entry fun register_asset(
        account: &signer,
        asset_id: vector<u8>
    ) {
        move_to(account, Asset {
            owner: signer::address_of(account),
            asset_id,
            livability_score: 100,
            structural_score: 100,
            risk_level: 0,
            last_updated: 0,
        });
    }

    public entry fun update_score(
        account: &signer,
        livability_score: u64,
        structural_score: u64,
        risk_level: u8,
        timestamp: u64
    ) acquires Asset {
        let asset = borrow_global_mut<Asset>(
            signer::address_of(account)
        );

        asset.livability_score = livability_score;
        asset.structural_score = structural_score;
        asset.risk_level = risk_level;
        asset.last_updated = timestamp;
    }
}
