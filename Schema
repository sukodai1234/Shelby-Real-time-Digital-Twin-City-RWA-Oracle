{
  "project": {
    "name": "Coastal Property Guardian",
    "assetType": "real-estate",
    "network": "aptos"
  },
  "dataSources": [
    {
      "id": "weather",
      "type": "rest-api",
      "provider": "openweather"
    },
    {
      "id": "salinity",
      "type": "iot-sensor",
      "unit": "ppt"
    }
  ],
  "scores": [
    {
      "name": "structuralHealth",
      "formula": "100 - salinity * 0.6 - humidity * 0.2"
    }
  ],
  "automations": [
    {
      "when": "structuralHealth < 40",
      "actions": [
        "setRiskLevel:HIGH",
        "writeOnChain",
        "sendAlert"
      ]
    }
  ]
}
